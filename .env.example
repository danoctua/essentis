# Copy to .env for local builds against real data. Never commit .env.
# Leave all of these empty and run `npm run dev` or `npm run build:fixtures` for sample content.

# Firebase
FIREBASE_SERVICE_ACCOUNT=        # base64 of the service account key JSON (secret)
PUBLIC_FIREBASE_CONFIG=          # web app config as one-line JSON (public); needed for /admin/
# Access to /admin/ is a custom claim, not a variable: npm run admin:grant -- you@gmail.com

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=                # secret
R2_SECRET_ACCESS_KEY=            # secret
R2_BUCKET=essentis-media
PUBLIC_MEDIA_URL=https://media.essentis.xyz

# Vercel
VERCEL_DEPLOY_HOOK_URL=          # secret

# Local only: build with sample content from fixtures/
# USE_FIXTURES=1
