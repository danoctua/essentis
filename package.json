{
  "name": "essentis",
  "type": "module",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:fixtures": "USE_FIXTURES=1 astro build",
    "preview": "python3 -m http.server 4321 -d .vercel/output/static",
    "test": "vitest run",
    "check": "tsc --noEmit -p .",
    "seed": "node --env-file-if-exists=.env scripts/seed.mjs",
    "admin:grant": "node --env-file-if-exists=.env scripts/grant-admin.mjs",
    "emulators": "npx -y firebase-tools@15.37.0 emulators:start --only auth,firestore --project demo-essentis",
    "dev:emulators": "FIREBASE_SERVICE_ACCOUNT= FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 PUBLIC_FIREBASE_EMULATORS=1 astro dev",
    "tokens": "node scripts/tokens.mjs",
    "fonts": "node scripts/fonts.mjs"
  },
  "dependencies": {
    "@astrojs/preact": "^6.1.6",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.6",
    "@astrojs/vercel": "^11.0.22",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource/alegreya": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^7.4.13",
    "aws4fetch": "^1.0.20",
    "codemirror": "^6.0.2",
    "firebase": "^13.4.0",
    "firebase-admin": "^14.5.1",
    "preact": "^10.29.8",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "satori": "^0.63.2",
    "shiki": "^4.6.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.65.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
