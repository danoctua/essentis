---
/** A Telegram album on Home: thumbnail, "Place // Year", photo count. Links out to the channel. */
import type { Note } from '../lib/content';
import { mediaUrl } from '../lib/site';
import { noteTitle } from '../lib/view';
import { NB, ui, type Lang } from '../data/ui';
interface Props { note: Note; lang: Lang }
const { note, lang } = Astro.props;
const first = note.photos[0];
const thumb = first ? mediaUrl(first.key, 400) : null;
const t = ui[lang];
---
<a class="note" href={note.tgUrl}>
  {thumb ? <img class="thumb" src={thumb} alt="" width="72" height="72" loading="lazy" /> : <span class="thumb ph" aria-hidden="true" />}
  <span class="body">
    <span class="ttl">{noteTitle(note)}</span>
    <span class="meta">{note.photos.length}{NB}{t.photos}, Telegram</span>
  </span>
</a>
<style>
  .note { display: flex; align-items: center; gap: 16px; padding: 14px 0; border-top: 1px solid var(--line); text-decoration: none; min-height: var(--tap-min); }
  .note:hover .ttl { color: var(--rust); }
  .thumb { flex: none; width: 72px; height: 72px; border-radius: var(--radius-md); object-fit: cover; box-shadow: inset 0 0 0 1px var(--line); }
  .ph { background: repeating-linear-gradient(135deg, var(--paper-raised) 0 8px, var(--paper) 8px 16px); }
  .body { flex: 1; min-width: 0; }
</style>
