---
import Divider from './Divider.astro';
import { site } from '../lib/site';
import type { Lang } from '../data/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<div class="wrap foot-wrap">
  <Divider />
  <footer class="foot">
    <ul>
      {site.links.map((l) => <li><a href={l.href}>{l.label[lang]}</a></li>)}
    </ul>
    <p>essentis, {new Date().getFullYear()}</p>
  </footer>
</div>
