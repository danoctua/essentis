---
import { renderMarkdown } from '../lib/markdown';
import { fmtDay, ui, type Lang } from '../data/ui';
import type { NowPage } from '../lib/content';
interface Props { now: NowPage; lang: Lang }
const { now, lang } = Astro.props;
const t = ui[lang];
const has = (l: Lang) => !!now[l]?.body?.trim();
const textLang: Lang = has(lang) ? lang : has('be') ? 'be' : 'en';
const doc = now[textLang];
const html = doc ? await renderMarkdown(doc.body, { lang: textLang, now: true }) : '';
---
<section id="now" class="now" aria-labelledby="now-h">
  <h2 id="now-h" class="h2">{t.now}</h2>
  <div class="prose now-text" lang={textLang !== lang ? textLang : undefined} set:html={html} />
  {textLang !== lang && <p class="label">{t.notTranslated}</p>}
  <p class="label now-date">{t.updated(fmtDay(new Date(now.updatedAt), lang))}</p>
</section>
<style>
  .now { background: var(--paper-raised); border-radius: var(--radius-lg); padding: 24px; box-shadow: inset 0 0 0 1px var(--line); }
  .now-text { margin-top: 8px; }
  .now-text :global(p:last-child), .now-text :global(ul:last-child) { margin-bottom: 0; }
  .now-date { margin: 16px 0 0; }
</style>
