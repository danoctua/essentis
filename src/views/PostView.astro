---
import Base from '../layouts/Base.astro';
import PostOrnament from '../components/PostOrnament.astro';
import PostRow from '../components/PostRow.astro';
import Divider from '../components/Divider.astro';
import type { PostView as PV } from '../lib/view';
import { renderMarkdown } from '../lib/markdown';
import { postAlternates } from '../lib/routes';
import { site } from '../lib/site';
import { fmtDate, NB, ui, weekday, type Lang } from '../data/ui';

interface Props { lang: Lang; post: PV; prev?: PV; next?: PV }
const { lang, post: p, prev, next } = Astro.props;
const t = ui[lang];
const html = await renderMarkdown(p.body, { lang: p.lang });
const fl = p.foreign ? p.lang : undefined;
const iso = p.date.toISOString().slice(0, 10);
---
<Base {lang} title={p.title} description={p.dek} alternates={postAlternates(p.slug)} current="writing" type="article" image={`/og/${lang}/${p.slug}.png`}>
  <article>
    <div class="head">
      <div class="head-text">
        <p class="meta-line"><time datetime={iso}>{fmtDate(p.date, lang)}</time>, {weekday(p.date, lang)}. {p.minutes}{NB}{t.minRead}{p.foreign && `, ${t.langName[p.lang]}`}.</p>
        <h1 class="page-title post-title" lang={fl}>{p.title}</h1>
        {p.gloss && <p class="gloss-line" lang={lang}>{p.gloss}</p>}
        {p.dek && <p class="dek-line" lang={fl}>{p.dek}</p>}
        {p.foreign && <p class="foreign">{t.foreignNote[p.lang]}</p>}
      </div>
      <PostOrnament seed={p.seed} size={96} />
    </div>
    <div class="read" lang={fl} data-note-label={t.note} set:html={html} />
    <Divider short />
  </article>
  <p class="discuss"><a href={site.channelUrl}>{t.discuss}</a></p>
  {(prev || next) && (
    <nav class="pn" aria-label={t.otherPosts}>
      {prev && <div><p class="label">{t.prev}</p><ul class="rows"><li><PostRow post={prev} pageLang={lang} /></li></ul></div>}
      {next && <div><p class="label">{t.next}</p><ul class="rows"><li><PostRow post={next} pageLang={lang} /></li></ul></div>}
    </nav>
  )}
</Base>
<script>
  // Footnotes open in place: each marker becomes a button that shows its note under the paragraph.
  // Without JS the marker stays a link to the list at the end.
  for (const read of document.querySelectorAll<HTMLElement>('.read')) {
    const label = read.dataset.noteLabel ?? '';
    read.querySelectorAll<HTMLAnchorElement>('a[data-footnote-ref]').forEach((a, i) => {
      const item = document.getElementById(decodeURIComponent(a.hash.slice(1)));
      const sup = a.parentElement;
      if (!item || !sup) return;
      const n = a.textContent ?? String(i + 1);
      const box = document.createElement('div');
      box.className = 'fn-open';
      box.id = `fn-open-${i + 1}`;
      box.setAttribute('role', 'note');
      box.hidden = true;
      for (const child of item.children) box.append(child.cloneNode(true));
      const num = document.createElement('span');
      num.className = 'fn-num';
      num.textContent = `${n}\u00a0`;
      (box.firstElementChild ?? box).prepend(num);
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'fn';
      button.textContent = n;
      button.setAttribute('aria-expanded', 'false');
      button.setAttribute('aria-controls', box.id);
      button.setAttribute('aria-label', `${label} ${n}`);
      button.addEventListener('click', () => {
        const open = button.getAttribute('aria-expanded') !== 'true';
        button.setAttribute('aria-expanded', String(open));
        box.hidden = !open;
      });
      sup.replaceWith(button);
      const block = button.closest('p, li, td, th, blockquote');
      if (block?.tagName === 'P') {
        // Several notes in one paragraph open in their own order.
        let after: Element = block;
        while (after.nextElementSibling?.classList.contains('fn-open')) after = after.nextElementSibling;
        after.after(box);
      } else (block ?? read).append(box);
    });
  }
</script>
<style>
  .head { display: grid; gap: 24px; padding-top: 56px; }
  .head-text { max-width: 760px; }
  .meta-line { margin: 0; font-size: 15px; color: var(--muted); }
  .post-title { margin-top: 12px; }
  .gloss-line { margin: 6px 0 0; color: var(--muted); }
  .dek-line { margin: 20px 0 0; font-family: var(--font-serif); font-style: italic; font-size: 22px; line-height: 1.4; }
  .foreign { margin: 16px 0 0; font-size: 15px; color: var(--muted); }
  .read { margin-top: 48px; }
  article :global(.divider) { margin: 40px 0; }
  .discuss { margin: 40px 0 0; }
  .discuss a { display: inline-flex; align-items: center; min-height: var(--tap-min); font-weight: 500; }
  .pn { display: grid; gap: 24px; margin-top: 48px; }
  .pn .label { margin: 0 0 4px; }
  @media (min-width: 720px) { .pn { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 900px) { .head { grid-template-columns: minmax(0, 1fr) 120px; gap: 48px; padding-top: 88px; } }
</style>
