rules_version = '2';

// Only the site owner can read or write, from /admin. Their account carries the custom claim
// `admin: true` (npm run admin:grant). Everyone else, signed in or not, gets nothing: the public
// site is static HTML built with the admin SDK, which these rules do not apply to.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
